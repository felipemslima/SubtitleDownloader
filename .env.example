# Copie este arquivo para .env e ajuste conforme sua maquina.

# Backend Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Frontend Vite
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_PREVIEW_HOST=127.0.0.1
VITE_PREVIEW_PORT=4173

# API usada pelo navegador.
# Local:
VITE_API_LOCAL_BASE_URL=http://127.0.0.1:5000/api

# Rede local:
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5001
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_PORT=5175
# VITE_API_LOCAL_BASE_URL=http://SEU_IP_DA_REDE:5001/api
